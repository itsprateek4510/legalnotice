# Copy this file to .env and fill in your values.

# --- LLM provider ---
# One of: "gemini" (default), "openai", "ollama"
LLM_PROVIDER=gemini

# --- Google Gemini (default provider) ---
# Get a free API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_key_here
# Model options: gemini-3.6-flash, gemini-2.5-pro, etc.
GEMINI_MODEL=gemini-3.6-flash

# --- OpenAI (alternative provider) ---
# Only needed if LLM_PROVIDER=openai.
# Get your key from https://platform.openai.com/api-keys
OPENAI_API_KEY=your_key_here
# Model options: gpt-3.5-turbo, gpt-4, gpt-4-turbo, etc.
LLM_MODEL=gpt-3.5-turbo

# Optional: use an OpenAI-compatible base URL (proxies/gateways).
# Leave empty to use the default OpenAI endpoint.
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Optional local LLM via Ollama ---
# Only needed if LLM_PROVIDER=ollama (or set USE_LOCAL_LLM=true).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# Legacy flag: setting this to true forces the Ollama provider.
USE_LOCAL_LLM=false

# --- Server ---
PORT=8000
HOST=0.0.0.0

# --- Database & Auth ---
# SQLite by default (file `app.db` in the backend folder).
DATABASE_URL=sqlite:///./app.db
# IMPORTANT: set a strong random secret in production (min 32 chars).
SECRET_KEY=dev-secret-change-me-0123456789-0123456789abcdefgh
JWT_EXPIRE_MINUTES=1440

# --- CORS ---
# Comma-separated list of allowed frontend origins.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Limits ---
# Max upload size in bytes (default 10 MB).
MAX_FILE_SIZE=10485760